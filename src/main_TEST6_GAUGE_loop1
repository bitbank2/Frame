float convertXemicsToFloat(uint8_t xemics[4])
{
  // Extract components from the 4-byte format
  int exponent = (int)xemics[0] - 128;     // Biased exponent (subtract 128)
  int sign = (xemics[1] & 0x80) ? -1 : +1; // Sign bit (bit 7 of byte 1)

  // Extract mantissa (23 bits) and add implied 1-bit
  uint32_t mantissa = ((xemics[1] & 0x7F) << 16 | // 7 bits from byte 1
                       xemics[2] << 8 |           // 8 bits from byte 2
                       xemics[3]) |               // 8 bits from byte 3
                      0x800000;                   // Add implied 1-bit at position 23

  // Convert to float using ldexp (load exponent)
  // -24 so the mantissa is valued like 0.1bbb... (0.5 <= value < 1.0)
  // and then the exponent is applied
  float value = sign * ldexp(mantissa, exponent - 24);

  return value;
}

bool ensureCCGainPositive()
{
  uint8_t blockControl[] = {0x69, 0x00}; // Class 0x69, Block 0
  uint8_t dataBuffer[32];
  uint8_t checksumValue;

  Serial.println("=== Ensuring CC_Gain is Positive ===");

  // Step 1: Read current CC_Gain block
  if (!lipo.i2cWriteBytes(0x3E, blockControl, 2))
  {
    Serial.println("Failed to set block data control");
    return false;
  }

  delay(10);

  if (!lipo.i2cReadBytes(0x40, dataBuffer, 32))
  {
    Serial.println("Failed to read data block");
    return false;
  }

  // Step 2: Convert current CC_Gain to float and check sign
  float currentCCGain = convertXemicsToFloat(&dataBuffer[4]);

  Serial.print("Current CC_Gain: ");
  Serial.println(currentCCGain, 6);

  // Step 3: Check if CC_Gain is negative
  if (currentCCGain >= 0)
  {
    Serial.println("CC_Gain is already positive - no change needed");
    return true;
  }

  // Step 4: CC_Gain is negative, flip the sign bit
  Serial.println("CC_Gain is negative - flipping to positive");

  // Show bytes before flip
  Serial.print("Before flip: ");
  for (int i = 4; i < 8; i++)
  {
    if (dataBuffer[i] < 0x10)
      Serial.print("0");
    Serial.print(dataBuffer[i], HEX);
    Serial.print(" ");
  }
  Serial.println();

  // Flip sign bit (bit 7 of byte at offset 5)
  dataBuffer[5] ^= 0x80; // XOR with 0x80 to flip bit 7

  // Show bytes after flip
  Serial.print("After flip:  ");
  for (int i = 4; i < 8; i++)
  {
    if (dataBuffer[i] < 0x10)
      Serial.print("0");
    Serial.print(dataBuffer[i], HEX);
    Serial.print(" ");
  }
  Serial.println();

  // Step 5: Calculate new checksum
  uint8_t sum = 0;
  for (int i = 0; i < 32; i++)
  {
    sum += dataBuffer[i];
  }
  checksumValue = 255 - sum; // Two's complement checksum

  Serial.print("New checksum: 0x");
  if (checksumValue < 0x10)
    Serial.print("0");
  Serial.println(checksumValue, HEX);

  // Step 6: Write modified block back
  if (!lipo.i2cWriteBytes(0x3E, blockControl, 2))
  {
    Serial.println("Failed to set block control for writing");
    return false;
  }

  delay(10);

  if (!lipo.i2cWriteBytes(0x40, dataBuffer, 32))
  {
    Serial.println("Failed to write modified block");
    return false;
  }

  delay(10);

  // Step 7: Write checksum
  if (!lipo.i2cWriteBytes(0x60, &checksumValue, 1))
  {
    Serial.println("Failed to write checksum");
    return false;
  }

  delay(10);

  // Step 8: Verify the change
  if (!lipo.i2cWriteBytes(0x3E, blockControl, 2))
  {
    Serial.println("Failed to set block control for verification");
    return false;
  }

  delay(10);

  uint8_t verifyBuffer[32];
  if (!lipo.i2cReadBytes(0x40, verifyBuffer, 32))
  {
    Serial.println("Failed to read for verification");
    return false;
  }

  // Convert back to float to verify
  float newCCGain = convertXemicsToFloat(&verifyBuffer[4]);

  Serial.print("New CC_Gain: ");
  Serial.println(newCCGain, 6);

  // Check if successful
  if (newCCGain >= 0)
  {
    Serial.println("SUCCESS: CC_Gain is now positive!");
    Serial.print("Changed from ");
    Serial.print(currentCCGain, 6);
    Serial.print(" to ");
    Serial.println(newCCGain, 6);
    return true;
  }
  else
  {
    Serial.println("FAILED: CC_Gain is still negative");
    return false;
  }
}
